{
  "enabledPlugins": {},
  "permissions": {
    "allow": [
      "Bash(bash:*)",
      "Bash(bun test:*)",
      "Bash(bun:*)",
      "Bash(cat:*)",
      "Bash(claude:*)",
      "Bash(cp:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(kill)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(realpath:*)",
      "Bash(rm:*)",
      "Bash(tee:*)",
      "Bash(wait)",
      "Bash(wc:*)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Write",
      "mcp__atlassian__*",
      "mcp__linear__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-bash-stdin-spawn.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
